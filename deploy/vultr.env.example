# Copy to vultr.env on the server. Never commit the populated file.
PUBLIC_DOMAIN=willitfit.tech
PUBLIC_BASE_URL=https://willitfit.tech

MONGODB_URI=
MONGODB_DATABASE=will_it_fit
BACKBOARD_API_KEY=
BACKBOARD_ASSISTANT_ID=
BACKBOARD_BASE_URL=https://app.backboard.io/api
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
# Replace before deployment. Sent only by the trusted demo client/server.
SPONSOR_DEMO_TOKEN=replace_with_a_long_random_demo_token

# Existing backend settings used only by services enabled on this host.
SERPAPI_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
DIMENSION_LLM_ENABLED=false
