# Active local vision model (Milestone 5.5). No API key needed.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3-vl:8b
OLLAMA_TIMEOUT_SECONDS=180
# Small local text model that only extracts dimensions from retailer text
OLLAMA_DIMENSION_MODEL=qwen3:4b-instruct
OLLAMA_DIMENSION_TIMEOUT_SECONDS=90
OLLAMA_DIMENSION_NUM_CTX=8192
DIMENSION_LLM_ENABLED=true
DIMENSION_PAGE_MAX_CHARS=12000
DIMENSION_HELPER_URL=http://127.0.0.1:8020
DIMENSION_CRAWL_ENABLED=true
DIMENSION_WEB_SEARCH_ENABLED=true
DIMENSION_BROWSER_USE_ENABLED=true
# Multi-query product retrieval
PRODUCT_SEARCH_MAX_QUERIES=3
# Legacy Gemini settings (no longer used by the active path)
GEMINI_API_KEY=replace_with_your_hackgt_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=45
SERPAPI_API_KEY=replace_with_your_serpapi_api_key
# Google Lens uses the same SerpApi key and direct Image API uploads.
LENS_SEARCH_ENABLED=true
LENS_MODES=products,visual_matches,exact_matches
# Bounded one-candidate-at-a-time qwen3-vl comparisons over the top shortlist.
# Failures fall back to deterministic text + Lens ranking.
VISUAL_RERANK_ENABLED=true
VISUAL_RERANK_MODEL=qwen3-vl:8b
VISUAL_RERANK_MAX_CANDIDATES=3
VISUAL_RERANK_TIMEOUT_SECONDS=180
VISUAL_RERANK_NUM_CTX=16384
